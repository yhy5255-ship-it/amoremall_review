# Copy to .env.local for `vercel dev`, or set as a Project env var in the Vercel dashboard.
# Never commit real values - .env.local is gitignored below.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional - override the default model (gemini-3.6-flash).
# GEMINI_MODEL=gemini-2.5-pro

# Needed only for the "데이터 최신화" button (api/refresh.js), which re-pulls the sheet
# on demand instead of requiring scripts/export_agg.py to be re-run manually.
# - Locally, api/refresh.js falls back to reading the same service-account key FILE
#   scripts/export_agg.py uses (see GOOGLE_SERVICE_ACCOUNT_KEY there), so you usually
#   don't need to set anything here for `vercel dev`.
# - Once deployed, Vercel's functions can't read a local file path, so set the full
#   service-account key JSON (the whole .json file's contents, as one line) here instead.
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}

# The monthly review's "참고 자료 선택" (api/monthly-reference.js) reuses these SAME
# GOOGLE_SERVICE_ACCOUNT_KEY(_JSON) vars above - no separate credentials needed.
# It lists/reads past human-written monthly review sheets via the Drive API, live -
# just invite amoremall-review@arctic-plate-468205-n6.iam.gserviceaccount.com (viewer)
# to each new monthly review sheet; it shows up in the picker immediately, no config
# file or redeploy needed.

# Needed only for the "완료 시 Slack 알림 받기" checkbox (api/notify-slack.js).
# A Slack app's Bot User OAuth Token (starts with xoxb-) - see OAuth & Permissions in
# the Slack app admin page. Needs the chat:write scope, and the bot must be invited
# into the target channel (channel ID is a plain constant in api/notify-slack.js, not
# a secret, so it isn't an env var here).
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
